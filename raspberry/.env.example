# Ikke legg OPENAI_API_KEY på Raspberry Pi-en. Denne tokenen er kun for boksen.
RASPBERRY_DEVICE_TOKEN=replace-with-a-long-random-value
# Produksjonsdomenet til Liv-administrasjonen.
REALTIME_TOKEN_URL=https://chatbox-config.vercel.app/api/realtime-token
# Innstillingene under er lokale reserver hvis nettsiden ikke svarer.
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
REALTIME_SPEED=1.0
NOISE_REDUCTION=far_field
TRANSCRIPTION_MODEL=gpt-realtime-whisper
MAX_OUTPUT_TOKENS=512
REASONING_EFFORT=low
SYSTEM_PROMPT=Du heter Liv og er en trygg og hyggelig norsk samtalepartner.
GREETING=Hei! Hva har du lyst til å snakke om?
VAD_EAGERNESS=auto
MEMORY_ENABLED=true
MEMORY_LIMIT=8
# MEMORY_DB=/home/piadmin/.local/share/chatbox/memory.sqlite3
# AUDIO_INPUT_DEVICE=Jabra
# AUDIO_OUTPUT_DEVICE=Jabra
# Endepunktet leser samme public/config.json direkte fra GitHub uten CDN-cache.
CHATBOX_CONFIG_URL=https://chatbox-config.vercel.app/api/config
CONFIG_REFRESH_SECONDS=300
